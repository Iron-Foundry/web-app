{
  "name": "web-app",
  "version": "1.12.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.tsx",
    "start": "NODE_ENV=production bun src/index.tsx",
    "build": "bun run build.ts",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "preview-embeds": "bun run scripts/preview-embeds.ts",
    "test": "bun test tests/",
    "test:e2e": "playwright test",
    "gen:api-types": "bun node_modules/openapi-typescript/bin/cli.js ../api-backend/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/react-query": "^5.100.8",
    "@tanstack/react-router": "^1.163.3",
    "@tanstack/react-virtual": "^3.14.2",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.12",
    "lucide-react": "^0.575.0",
    "radix-ui": "^1.4.3",
    "react": "^19",
    "react-colorful": "^5.8.0",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "recharts": "2.15.4",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "satori": "^0.26.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "three": "^0.184.0"
  },
  "patchedDependencies": {
    "victory-vendor@36.9.2": "patches/victory-vendor@36.9.2.patch"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.0",
    "@playwright/test": "^1.61.1",
    "@tanstack/react-query-devtools": "^5.100.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/dompurify": "^3.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "happy-dom": "^20.11.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.1.11",
